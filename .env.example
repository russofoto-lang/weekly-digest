# Progetto Firebase/Google Cloud che contiene Firestore.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Token condiviso richiesto nell'header X-Digest-Token delle route POST protette.
DIGEST_TOKEN=generate-a-long-random-secret

# API key per l'invio futuro del digest via Resend.
RESEND_API_KEY=re_xxxxxxxxx

# URL pubblico dell'app, usato per i link /leggi/{id} degli articoli.
BASE_URL=https://weekly-digest-xxxxxxxx.europe-west8.run.app

# Destinatari separati da virgola e mittente verificato su Resend.
DIGEST_RECIPIENTS=nome@example.com,altro@example.com
DIGEST_FROM=Weekly Digest <digest@example.com>

# Cloud Run imposta PORT automaticamente.
PORT=8080

# Solo per sviluppo locale senza Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
